<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UpdateExpress</AssemblyName>
    <Version>0.7.2.29</Version>
    <InformationalVersion>0.7.2.29</InformationalVersion>
    <FileVersion>0.7.2.29</FileVersion>
    <AssemblyVersion>0.7.2.29</AssemblyVersion>
    <Product>Update Express</Product>
    <ApplicationIcon>Assets\UpdateExpress-U.ico</ApplicationIcon>
    <StartupObject>UpdateExpress.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\MicroSystemsBanner.png" />
    <Resource Include="Assets\UpdateExpress-U.png" />
    <Resource Include="Assets\HelpRowTools.png" />
    <Resource Include="Assets\UpdateExpress-U.ico" />
    <Resource Include="Assets\UpdateExpressWindow.ico" />
    <EmbeddedResource Include="Assets\UpdateExpress-U.ico" LogicalName="UpdateExpress.Assets.UpdateExpress.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.11" />
  </ItemGroup>
</Project>
