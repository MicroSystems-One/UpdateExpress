<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UpdateExpress</AssemblyName>
    <Version>0.7.2.6</Version>
    <InformationalVersion>0.7.2.6.82</InformationalVersion>
    <FileVersion>0.7.2.6</FileVersion>
    <AssemblyVersion>0.7.2.6</AssemblyVersion>
    <Product>Update Express</Product>
    <ApplicationIcon>Assets\UpdateExpress-U.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\MicroSystemsBanner.png" />
    <Resource Include="Assets\MicroSystems-M.png" />
    <Resource Include="Assets\FixIt.png" />
    <Resource Include="Assets\UpdateExpress-U.png" />
    <Resource Include="Assets\UpdateExpress-U.ico" />
    <Resource Include="Assets\UpdateExpressWindow.ico" />
    <EmbeddedResource Include="Assets\UpdateExpress-U.ico" LogicalName="UpdateExpress.Assets.UpdateExpress.ico" />
  </ItemGroup>
</Project>
