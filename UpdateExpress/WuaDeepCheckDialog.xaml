<Window x:Class="UpdateExpress.WuaDeepCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WUA deep check"
        Width="760" Height="560" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6FB" FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="#EBF2FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="14" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="WUA deep check" FontSize="18" FontWeight="SemiBold" Foreground="#152137"/>
      <TextBlock Grid.Row="1" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="#52617A"
                 Text="Read-only analysis of Windows Update Agent health: network/DNS/TCP to Microsoft endpoints, local services, proxy, policy, reboot pending, and a light WUA search. Use when Quick/Medium/Deep fix did not help."/>
      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <TextBlock x:Name="ProgressLabel" Text="Ready." FontSize="12" Foreground="#52617A" Margin="0,0,0,4"/>
        <ProgressBar x:Name="ProgressBar" Height="7" IsIndeterminate="False" Value="0" Foreground="#0067C0"/>
      </StackPanel>
      <TextBox x:Name="ReportBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               FontFamily="Consolas" FontSize="11" BorderBrush="#DDE3EB" Padding="10"
               Background="#F8FAFC"
               Text="Confirm to start. A copyable AI prompt is generated when the check finishes."/>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Height="30" Margin="0,14,0,0">
        <Button x:Name="StartButton" Content="Start check" Style="{StaticResource DialogActionButton}"
                Background="#0067C0" Foreground="White" BorderBrush="#0067C0" FontWeight="SemiBold"
                Click="Start_Click"/>
        <Button x:Name="CopyButton" Content="Copy AI prompt" Style="{StaticResource DialogActionButton}"
                IsEnabled="False" Click="Copy_Click"/>
        <Button x:Name="FolderButton" Content="Open log folder" Style="{StaticResource DialogActionButton}"
                Click="Folder_Click"/>
        <Button Content="Close" Style="{StaticResource DialogActionButton}" Margin="0" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
