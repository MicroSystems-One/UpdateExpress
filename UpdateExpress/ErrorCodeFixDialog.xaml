<Window x:Class="UpdateExpress.ErrorCodeFixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Update error"
        Width="640" Height="480" MinWidth="600" MinHeight="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False" Icon="Assets/UpdateExpress-U.ico">
  <Window.Resources>
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="#EBF2FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="CodeTitle" FontSize="20" FontWeight="SemiBold" Foreground="#C62828"/>
      <TextBlock x:Name="NameText" Grid.Row="1" Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#1C1C1C" TextWrapping="Wrap"/>
      <TextBlock x:Name="KnownBadge" Grid.Row="2" Margin="0,4,0,10" FontSize="11" Foreground="#5D5D5D"/>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="What it means" FontWeight="SemiBold" Foreground="#1C1C1C" Margin="0,0,0,4"/>
          <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,12"/>
          <TextBlock Text="Recommended action" FontWeight="SemiBold" Foreground="#1C1C1C" Margin="0,0,0,4"/>
          <TextBlock x:Name="GuidanceText" TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,12"/>
          <TextBlock x:Name="FixLevelText" TextWrapping="Wrap" Foreground="#1565C0" FontWeight="SemiBold"/>
          <TextBlock x:Name="ContextText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#5D5D5D" FontSize="11"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="4" Margin="0,12,0,0">
        <Hyperlink x:Name="LearnMoreLink" RequestNavigate="LearnMore_RequestNavigate">
          <Run Text="Microsoft documentation"/>
        </Hyperlink>
      </TextBlock>
      <WrapPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="ReinstallButton" Content="Install again" Style="{StaticResource DialogActionButton}"
                Background="#0067C0" Foreground="White" BorderBrush="#0067C0" FontWeight="SemiBold"
                Click="Reinstall_Click" Visibility="Collapsed"/>
        <Button x:Name="HideButton" Content="Hide" Style="{StaticResource DialogActionButton}"
                Click="Hide_Click"/>
        <Button x:Name="RunFixButton" Content="Run recommended fix" Style="{StaticResource DialogActionButton}"
                Click="RunFix_Click"/>
        <Button x:Name="ChooseFixButton" Content="Choose fix level…" Style="{StaticResource DialogActionButton}"
                Click="ChooseFix_Click"/>
        <Button x:Name="CloseButton" Content="Close" Style="{StaticResource DialogActionButton}" Margin="0" Click="Close_Click"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
