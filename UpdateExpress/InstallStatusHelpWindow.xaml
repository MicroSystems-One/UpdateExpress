<Window x:Class="UpdateExpress.InstallStatusHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation help"
        Width="620" Height="460" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False">
  <Border Margin="14" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Foreground="#1C1C1C" TextWrapping="Wrap"/>
      <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#C62828" TextWrapping="Wrap"/>
      <TextBlock x:Name="SourceText" Grid.Row="2" Margin="0,4,0,10" FontSize="12" Foreground="#5D5D5D" TextWrapping="Wrap"/>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="WhatLabel" Text="What happened" FontWeight="SemiBold" Foreground="#1C1C1C" Margin="0,0,0,4"/>
          <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,14"/>
          <TextBlock x:Name="TryLabel" Text="What you can try" FontWeight="SemiBold" Foreground="#1C1C1C" Margin="0,0,0,4"/>
          <TextBlock x:Name="StepsText" TextWrapping="Wrap" Foreground="#334155"/>
        </StackPanel>
      </ScrollViewer>
      <WrapPanel Grid.Row="4" Margin="0,12,0,0">
        <Button x:Name="CatalogButton" Content="Open Update Catalog" Padding="10,5" Margin="0,0,8,0" Click="Catalog_Click" Visibility="Collapsed"/>
        <Button x:Name="StoreButton" Content="Open Microsoft Store" Padding="10,5" Margin="0,0,8,0" Click="Store_Click" Visibility="Collapsed"/>
        <Button x:Name="LearnMoreButton" Content="Learn more" Padding="10,5" Margin="0,0,8,0" Click="LearnMore_Click" Visibility="Collapsed"/>
      </WrapPanel>
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="CloseButton" Content="Close" Padding="14,5" IsCancel="True" IsDefault="True" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
