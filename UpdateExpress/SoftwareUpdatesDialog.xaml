<Window x:Class="UpdateExpress.SoftwareUpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Express – Updates"
        Width="720" Height="500" MinWidth="640" MinHeight="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F3F6FB" FontFamily="Segoe UI">
  <Window.Resources>
    <!-- Override App.xaml MinHeight=39 so all footer actions share one 27px row. -->
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="27"/>
      <Setter Property="MinHeight" Value="27"/>
      <Setter Property="MaxHeight" Value="27"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="#EBF2FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="18" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="14" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="HeadingText" Text="Windows updates ready" FontSize="20" FontWeight="SemiBold" Foreground="#152137"/>
      <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="#334155"/>
      <ListBox x:Name="UpdatesList" Grid.Row="2" BorderBrush="#DDE3EB" BorderThickness="1"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      <TextBlock Grid.Row="3" Margin="0,12,0,8" TextWrapping="Wrap" Foreground="#9B5A00"
                 Text="Update Express never restarts Windows automatically. Save your work before installing; a restart may still be required afterwards."/>
      <StackPanel x:Name="ProgressPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,0,0,10">
        <TextBlock x:Name="ProgressLabel" Text="Preparing…" FontSize="12" Foreground="#52617A" Margin="0,0,0,4"/>
        <ProgressBar x:Name="ProgressBar" Height="7" IsIndeterminate="True" Foreground="#F47700"/>
      </StackPanel>
      <StackPanel x:Name="ActionsPanel" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Height="27">
        <Button Content="Install now" Style="{StaticResource DialogActionButton}" Click="InstallNow_Click"/>
        <Button x:Name="PreferredButton" Content="Install at preferred time" Style="{StaticResource DialogActionButton}" Click="Preferred_Click"/>
        <Button Content="Remind in 1 hour" Style="{StaticResource DialogActionButton}" Click="RemindHour_Click"/>
        <Button Content="Remind tomorrow" Style="{StaticResource DialogActionButton}" Click="RemindDay_Click"/>
        <Button Content="Later" Style="{StaticResource DialogActionButton}" Margin="0" Click="Later_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
