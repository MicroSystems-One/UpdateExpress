<Window x:Class="UpdateExpress.WindowsUpdateFixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Update fix"
        Width="560" Height="480" MinWidth="520" MinHeight="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F6FB" FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <!-- Override App.xaml MinHeight=39 / Margin bottom so footer buttons share one row. -->
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="14" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Windows Update fix" FontSize="18" FontWeight="SemiBold" Foreground="#152137"/>
      <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="#52617A"
                 Text="Use when Windows Update shows nothing, is stuck, or returns error codes. Requires administrator. Folders are renamed (backup), not deleted."/>
      <StackPanel Grid.Row="2" Margin="0,0,0,10">
        <RadioButton x:Name="QuickOption" GroupName="FixLevel" IsChecked="True" Margin="0,0,0,8"
                     Checked="Level_Changed">
          <StackPanel>
            <TextBlock Text="Quick fix" FontWeight="SemiBold" Foreground="#152137"/>
            <TextBlock Text="Stop services → rename SoftwareDistribution + catroot2 → start services → detect updates"
                       TextWrapping="Wrap" Foreground="#52617A" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="MediumOption" GroupName="FixLevel" Margin="0,0,0,8" Checked="Level_Changed">
          <StackPanel>
            <TextBlock Text="Medium fix" FontWeight="SemiBold" Foreground="#152137"/>
            <TextBlock Text="Quick fix + SFC /scannow (15–45 min)"
                       TextWrapping="Wrap" Foreground="#52617A" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="DeepOption" GroupName="FixLevel" Margin="0,0,0,0" Checked="Level_Changed">
          <StackPanel>
            <TextBlock Text="Deep fix" FontWeight="SemiBold" Foreground="#152137"/>
            <TextBlock Text="Medium fix + DISM /RestoreHealth (30–90+ min, needs network)"
                       TextWrapping="Wrap" Foreground="#52617A" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </RadioButton>
      </StackPanel>
      <Border Grid.Row="3" BorderBrush="#DDE3EB" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="LogText" Text="Select a level and click Run." TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="11" Foreground="#334155"/>
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed" x:Name="ProgressPanel">
        <TextBlock x:Name="ProgressLabel" Text="Running…" FontSize="12" Foreground="#52617A" Margin="0,0,0,4"/>
        <ProgressBar Height="7" IsIndeterminate="True" Foreground="#F47700"/>
      </StackPanel>
      <Grid Grid.Row="5" Margin="0,14,0,0" Height="30" VerticalAlignment="Bottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ErrorReportButton" Grid.Column="0" Content="Error report" Style="{StaticResource DialogActionButton}"
                HorizontalAlignment="Left" IsEnabled="False" Click="ErrorReport_Click"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RunButton" Content="Run" Style="{StaticResource DialogActionButton}" Click="Run_Click"
                  Background="#F47700" Foreground="White" BorderBrush="#F47700" FontWeight="SemiBold"/>
          <Button x:Name="CloseButton" Content="Close" Style="{StaticResource DialogActionButton}" Margin="0"
                  Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
