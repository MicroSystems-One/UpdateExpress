<Window x:Class="UpdateExpress.FixItWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIX IT! – Windows Update repair"
        Width="780" Height="360" MinWidth="720" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False"
        Closed="Window_Closed">
  <Window.Resources>
    <Style x:Key="FixItActionButton" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="#EBF2FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="Assets/FixIt.png" Width="40" Height="40" Stretch="Uniform" Margin="0,0,12,0"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="FIX IT! – Windows Update repair" FontSize="18" FontWeight="SemiBold" Foreground="#1C1C1C"/>
          <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#5D5D5D"
                     Text="Repair and diagnose stuck Windows Update problems. History and status updates appear in the main window."/>
        </StackPanel>
      </StackPanel>
      <Grid Grid.Row="2" Margin="0,16,0,0" VerticalAlignment="Top">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="WindowsUpdateFixButton" Grid.Row="0" Grid.Column="0" Content="⚒  Windows Update fix"
                Style="{StaticResource FixItActionButton}" Click="WindowsUpdateFix_Click"
                ToolTip="Quick / Medium / Deep repair for stuck or empty Windows Update"/>
        <Button x:Name="WuaDeepCheckButton" Grid.Row="0" Grid.Column="1" Content="🔍  WUA deep check"
                Style="{StaticResource FixItActionButton}" Click="WuaDeepCheck_Click"
                ToolTip="Read-only deep analysis when Windows Update fix did not help (network, services, WUA). ~2–4 min."/>
        <Button x:Name="HistoryButton" Grid.Row="0" Grid.Column="2" Content="☷  Installation History"
                Style="{StaticResource FixItActionButton}" Click="History_Click"
                ToolTip="Show Windows Update installation history in the main window"/>
        <Button x:Name="ExportCsvButton" Grid.Row="0" Grid.Column="3" Content="↓  Export CSV"
                Style="{StaticResource FixItActionButton}" Margin="0,0,0,8" Click="Export_Click"
                ToolTip="Export the current history list as a CSV file"/>
        <Button x:Name="ErrorReportButton" Grid.Row="1" Grid.Column="0" Content="📋  Error report"
                Style="{StaticResource FixItActionButton}" Margin="0,0,8,0" Click="ErrorReport_Click"
                ToolTip="AI troubleshooting prompt from the last Windows Update fix"/>
        <Button x:Name="WuaStatusReportButton" Grid.Row="1" Grid.Column="1" Content="📄  WUA status report"
                Style="{StaticResource FixItActionButton}" Margin="0,0,8,0" Click="WuaStatusReport_Click"
                ToolTip="Open the latest or a previous WUA deep check report"/>
        <Button x:Name="DiagnosticsButton" Grid.Row="1" Grid.Column="2" Content="⚙  Diagnostics"
                Style="{StaticResource FixItActionButton}" Margin="0,0,8,0" Click="Diagnostics_Click"
                ToolTip="Collect WUA diagnostics and open the report in Notepad"/>
        <Button x:Name="HealthButton" Grid.Row="1" Grid.Column="3" Content="✓  Check Status"
                Style="{StaticResource FixItActionButton}" Margin="0" Click="Health_Click"
                ToolTip="Refresh history and pending updates (health check)"/>
      </Grid>
      <Button x:Name="CloseButton" Grid.Row="3" Content="Close" Width="100" HorizontalAlignment="Right"
              Margin="0,16,0,0" Style="{StaticResource FixItActionButton}"
              Foreground="#182335" FontWeight="SemiBold" Click="Close_Click"/>
    </Grid>
  </Border>
</Window>
