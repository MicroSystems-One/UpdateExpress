<Window x:Class="UpdateExpress.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Express – Reminder"
        Width="660" MinWidth="580" MinHeight="300"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/UpdateExpress-U.ico"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <!-- Override App.xaml MinHeight=39 / Padding 17,10 / Margin bottom so all three footer buttons (incl. Lukk/Close) share one height. -->
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1C1C1C"/>
      <Setter Property="BorderBrush" Value="#E5E5E5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="20" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="22">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Height="30" Margin="0,16,0,0">
        <Button x:Name="AcknowledgeButton" Content="Confirm restart" Style="{StaticResource DialogActionButton}" Click="Confirm_Click"/>
        <Button x:Name="SnoozeButton" Content="Remind Me in 30 Minutes" Style="{StaticResource DialogActionButton}" Click="Snooze_Click"/>
        <Button x:Name="CloseButton" Content="Close" Style="{StaticResource DialogActionButton}" Margin="0" Click="Close_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock x:Name="DialogHeading" Text="Scheduled Windows Maintenance" FontSize="20" FontWeight="SemiBold" Foreground="#1C1C1C"/>
        <TextBlock x:Name="WhenText" Margin="0,10,0,10" FontWeight="SemiBold" Foreground="#1C1C1C" TextWrapping="Wrap"/>
        <TextBlock x:Name="MissedNoticeText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="#C45A00" FontWeight="SemiBold"/>
        <TextBlock x:Name="ReasonText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="#0F766E" FontWeight="SemiBold"/>
        <Border x:Name="PendingListPanel" Visibility="Collapsed" Background="#F7FAFD" BorderBrush="#D6E4F0"
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" MaxHeight="180">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PendingUpdatesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="#1C1C1C" FontSize="12"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock x:Name="SaveWorkText" Text="Save your work and close applications before leaving. An update or restart can otherwise cause loss of unsaved data." TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#1C1C1C"/>
        <TextBlock x:Name="PowerText" Text="Keep the PC powered on, connected to power and internet, and avoid sleep. Confirming schedules a restart in this time window." TextWrapping="Wrap" Foreground="#1C1C1C"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
