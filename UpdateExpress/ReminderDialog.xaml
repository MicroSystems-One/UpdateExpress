<Window x:Class="UpdateExpress.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Express – Reminder"
        Width="590" Height="390"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F6FB" FontFamily="Segoe UI">
  <Window.Resources>
    <!-- Override App.xaml MinHeight=39 / Padding 17,10 / Margin bottom so footer buttons share one baseline. -->
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="20" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="14" Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <TextBlock x:Name="DialogHeading" Text="Scheduled Windows Maintenance" FontSize="20" FontWeight="SemiBold" Foreground="#152137"/>
        <TextBlock x:Name="WhenText" Margin="0,10,0,14" FontWeight="SemiBold"/>
        <TextBlock x:Name="SaveWorkText" Text="Save your work and close applications before leaving. An update or restart can otherwise cause loss of unsaved data." TextWrapping="Wrap" Margin="0,0,0,14"/>
        <TextBlock x:Name="PowerText" Text="Keep the PC powered on, connected to power and internet, and prevent sleep. Updates may require a restart." TextWrapping="Wrap" Margin="0,0,0,14"/>
        <TextBlock x:Name="PilotText" Text="PILOT: This notification does not start updates or restart Windows." Foreground="#C45A00" TextWrapping="Wrap" Margin="0,0,0,16"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="30">
        <Button x:Name="AcknowledgeButton" Content="Acknowledge" Style="{StaticResource DialogActionButton}" Click="Confirm_Click"/>
        <Button x:Name="SnoozeButton" Content="Remind Me in 30 Minutes" Style="{StaticResource DialogActionButton}" Click="Snooze_Click"/>
        <Button x:Name="CloseButton" Content="Close" Style="{StaticResource DialogActionButton}" Margin="0" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
