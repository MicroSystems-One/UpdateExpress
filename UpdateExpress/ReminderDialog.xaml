<Window x:Class="UpdateExpress.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Express – Reminder"
        Width="640" Height="360" MinWidth="560" MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#1C1C1C"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/UpdateExpress-U.ico"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Border Margin="20" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="22">
    <StackPanel>
      <TextBlock x:Name="DialogHeading" Text="Scheduled Windows Maintenance" FontSize="20" FontWeight="SemiBold" Foreground="#1C1C1C"/>
      <TextBlock x:Name="WhenText" Margin="0,10,0,10" FontWeight="SemiBold" Foreground="#1C1C1C" TextWrapping="Wrap"/>
      <TextBlock x:Name="MissedNoticeText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,14"
                 Foreground="#C45A00" FontWeight="SemiBold"/>
      <TextBlock x:Name="SaveWorkText" Text="Save your work and close applications before leaving. An update or restart can otherwise cause loss of unsaved data." TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#1C1C1C"/>
      <TextBlock x:Name="PowerText" Text="Keep the PC powered on, connected to power and internet, and avoid sleep. Confirming schedules a restart in this time window." TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#1C1C1C"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="AcknowledgeButton" Content="Confirm restart" Click="Confirm_Click" MinHeight="28" Padding="12,4" Margin="0,0,8,0"/>
        <Button x:Name="SnoozeButton" Content="Remind Me in 30 Minutes" Click="Snooze_Click" MinHeight="28" Padding="12,4" Margin="0,0,8,0"/>
        <Button x:Name="CloseButton" Content="Close" Click="Close_Click" MinHeight="28" Padding="12,4"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
