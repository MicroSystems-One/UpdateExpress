<Window x:Class="UpdateExpress.ReminderDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Update Express – Reminder" Width="590" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Assets/UpdateExpress-U.ico">
  <Border Margin="20" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="22">
    <StackPanel>
      <TextBlock x:Name="DialogHeading" Text="Scheduled Windows Maintenance" FontSize="20" FontWeight="SemiBold" Foreground="#1C1C1C"/>
      <TextBlock x:Name="WhenText" Margin="0,10,0,14" FontWeight="SemiBold"/>
      <TextBlock x:Name="SaveWorkText" Text="Save your work and close applications before leaving. An update or restart can otherwise cause loss of unsaved data." TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock x:Name="PowerText" Text="Keep the PC powered on, connected to power and internet, and prevent sleep. Updates may require a restart." TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock x:Name="PilotText" Text="PILOT: This notification does not start updates or restart Windows." Foreground="#C45A00" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="AcknowledgeButton" Content="Acknowledge" Click="Confirm_Click"/>
        <Button x:Name="SnoozeButton" Content="Remind Me in 30 Minutes" Click="Snooze_Click"/>
        <Button x:Name="CloseButton" Content="Close" Click="Close_Click"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
