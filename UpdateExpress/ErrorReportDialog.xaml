<Window x:Class="UpdateExpress.ErrorReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Error report"
        Width="720" Height="540" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False" Icon="Assets/UpdateExpress-U.ico">
  <Window.Resources>
    <!-- Override App.xaml MinHeight=39 / Margin bottom so footer buttons share one row. -->
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="#EBF2FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="8" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Error report / AI prompt" FontSize="18" FontWeight="SemiBold" Foreground="#1C1C1C"/>
      <TextBlock Grid.Row="1" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="#5D5D5D"
                 Text="Copy this prompt into an AI chat or ticket for further Windows Update troubleshooting. Generated from the last Windows Update fix run."/>
      <TextBox x:Name="ReportBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               FontFamily="Consolas" FontSize="11" BorderBrush="#E5E5E5" Padding="10"
               Background="#F9F9F9"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Height="30" Margin="0,14,0,0">
        <Button Content="Copy to clipboard" Style="{StaticResource DialogActionButton}" Click="Copy_Click"/>
        <Button Content="Open log folder" Style="{StaticResource DialogActionButton}" Click="OpenFolder_Click"/>
        <Button Content="Close" Style="{StaticResource DialogActionButton}" Margin="0" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
