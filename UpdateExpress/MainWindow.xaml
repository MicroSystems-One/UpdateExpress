    <Border Background="#F4FBF7" BorderBrush="#C9E8D6" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Update until current" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Searches, downloads, and installs Windows software updates, restarts when Windows requires it, then repeats until none remain. Drivers, firmware, and feature updates stay manual." FontSize="12" Foreground="#5D5D5D" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="UpdateUntilCurrentButton" Content="Start update cycle" Click="UpdateUntilCurrent_Click" Padding="10,4" MinHeight="29" Margin="0,0,10,0"/>
          <TextBlock x:Name="UpdateUntilCurrentStatus" Text="Not running" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Text="Critical and general updates download in the background and ask before install. Default preferred time is 12:00. Auto-reboot is optional and off by default. Drivers and applications follow the same ask-before-install path when enabled below." FontSize="12" Foreground="#5D5D5D" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,0,0,4">
      <CheckBox x:Name="AutoDrivers" Content="Drivers automatic" Margin="0,0,18,6" ToolTip="Assigned WUA drivers: background download, ask before install. Firmware stays manual."/>
      <CheckBox x:Name="AutoApplications" Content="Application automatic" Margin="0,0,18,6" Click="AutoApplications_Click" ToolTip="WinGet upgrades: ask before install at the preferred time used by Critical updates."/>
      <TextBlock Text="Firmware: manual only" Foreground="#9B5A00" VerticalAlignment="Center" Margin="0,0,10,6"/>
      <Button Content="Save Policy" Click="SavePolicy_Click" Padding="10,4" MinHeight="29"/>
    </WrapPanel>
  </StackPanel></ScrollViewer></Expander></Border>
  <TextBlock Grid.Row="4" x:Name="FooterSafetyText" Text="Update Express: Defender signatures may auto-update when enabled. Critical and general Windows updates download automatically and require confirmation before install. Optional auto-reboot after critical updates / general Windows update is off by default (confirm or outside active hours). Drivers and WinGet applications use the same ask-before-install path when enabled; firmware stays manual." Foreground="#5D5D5D" FontSize="12" Margin="4,10,0,0" TextWrapping="Wrap"/>
 </Grid>
 </ScrollViewer>
</Window>
