ick" Style="{StaticResource CompactActionButton}"/></StackPanel></StackPanel></Grid></Expander.Header><Grid Margin="0,8,0,0" VerticalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
