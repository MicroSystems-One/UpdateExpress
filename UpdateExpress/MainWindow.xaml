<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UpdateExpress.MainWindow" Title="Update Express – Windows Update Management" Icon="Assets/UpdateExpress-U.ico" Width="1024" Height="768" MinWidth="1024" MinHeight="768" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="12"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#182F51" BlurRadius="10" ShadowDepth="2" Opacity="0.08"/></Setter.Value></Setter></Style>
  <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="MinWidth" Value="0"/></Style>
  <Style x:Key="SegmentRadio" TargetType="RadioButton">
   <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="SegmentBorder" Background="#F3F6FB" BorderBrush="#CBD4E0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#F47700"/><Setter Property="Foreground" Value="White"/><Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#F47700"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Unified typography for result lists: clear at 1024x768 and 100% scaling. -->
  <Style TargetType="DataGrid">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#152137"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="RowBackground" Value="White"/>
   <Setter Property="AlternatingRowBackground" Value="#F5F8FC"/>
   <Setter Property="AlternationCount" Value="2"/>
   <Setter Property="RowHeight" Value="34"/>
   <Setter Property="ColumnHeaderHeight" Value="34"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E6EBF2"/>
   <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#25354C"/>
   <Setter Property="Background" Value="#EAF0F7"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="BorderBrush" Value="#DDE5EF"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style x:Key="CenteredStatusHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <!-- Applied explicitly to every text column: DataGridTextColumn creates its own TextBlock,
       so an implicit window TextBlock style is not reliably inherited. -->
  <Style x:Key="CenteredGridText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="CenteredCheckCell" TargetType="DataGridCell">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#152137"/>
  </Style>
 </Window.Resources>
 <Grid Margin="12,0,12,7"><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Header: original transparent MicroSystems logo sits on a dark slate panel for readable white letters. -->
  <Grid Grid.Row="0" Margin="0,6,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
    <Border Width="55" Height="55" CornerRadius="13" Background="#FFF4E5" Margin="0,0,18,0"><Image Source="Assets/MicroSystems-M.png" Stretch="Uniform" Margin="3"/></Border>
    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="20" FontWeight="Bold"><Run Text="Update " Foreground="#142035"/><Run Text="Express" Foreground="#F46D00"/></TextBlock><TextBlock x:Name="AppSubtitle" Text="Windows Update Management · Background Monitoring" Foreground="#52617A" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   </StackPanel>
   <Border Grid.Column="1" Height="78" VerticalAlignment="Center" CornerRadius="14" Background="#344154" Padding="14,8" BorderBrush="#576477" BorderThickness="1"><Image Source="Assets/MicroSystems.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel>
   <!-- Compact title and Defender status share a single header row. -->
   <Grid Margin="0,0,0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-1,0,0">
     <TextBlock Text="↻" Foreground="#F47700" FontSize="20" FontWeight="Bold" Margin="0,-3,12,0"/>
     <TextBlock Text="Windows Update Control" FontSize="14" FontWeight="SemiBold" Foreground="#152137" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,14,0">
     <TextBlock x:Name="OsSupportIcon" Text="?" FontSize="14" FontWeight="Bold" Foreground="#B7791F" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <TextBlock x:Name="OsVersionLabel" Text="Checking Windows…" FontSize="12" FontWeight="SemiBold" Foreground="#152137" VerticalAlignment="Center"/>
     <Button x:Name="OsSupportInfo" Content="ⓘ" Click="OsSupportInfo_Click" ToolTip="Windows lifecycle and security support" FontSize="12" Padding="3,0" Margin="3,0,0,0" MinHeight="20" MinWidth="20" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Viewbox Width="32" Height="32" Margin="0,0,8,0" ToolTip="Antivirus protection status">
      <Canvas Width="96" Height="96">
       <Path x:Name="DefenderShield" Fill="#9099A6" Data="M48,5 L83,18 L83,43 C83,67 68,82 48,91 C28,82 13,67 13,43 L13,18 Z"/>
       <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M31,48 L43,60 L66,35"/>
      </Canvas>
     </Viewbox>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock Text="Microsoft Defender" FontWeight="SemiBold" Foreground="#152137" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock x:Name="DefenderLabel" Text="Checking…" Foreground="#52617A" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock x:Name="DefenderChecked" Text="Not checked" FontSize="12" Foreground="#52617A" VerticalAlignment="Center"/>
     </StackPanel>
     <Button x:Name="DefenderRefreshButton" Content="↻  Refresh Security Status" Click="DefenderRefresh_Click" FontSize="12" Padding="8,4" MinHeight="28" Margin="0" VerticalAlignment="Center"/>
    </StackPanel>

    </StackPanel>
   </Grid>
   <!-- Aligned connectivity and firewall status: same row, same Segoe UI 11px. -->
   <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <!-- Network diagnostics: independent HTTPS probes, not a Windows Update Agent test. -->
   <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0,8,0" VerticalAlignment="Center">
    <Ellipse x:Name="InternetLamp" Width="9" Height="9" Fill="#9099A6" Margin="0,0,6,0"/>
    <TextBlock x:Name="InternetStatusText" Text="Internet: checking …" FontSize="12" Foreground="#52617A" Margin="0,0,18,0"/>
    <Ellipse x:Name="UpdateServerLamp" Width="9" Height="9" Fill="#9099A6" Margin="0,0,6,0"/>
    <TextBlock x:Name="UpdateServerStatusText" Text="Microsoft TCP: checking …" FontSize="12" Foreground="#52617A" Margin="0,0,18,0"/>
    <Ellipse x:Name="WuaLamp" Width="9" Height="9" Fill="#9099A6" Margin="0,0,6,0"/>
    <TextBlock x:Name="WuaStatusText" Text="WUA: Ikke bekreftet" FontSize="12" Foreground="#52617A" Margin="0,0,18,0"/>
    <TextBlock x:Name="ProxyStatusText" Text="Proxy: checking …" FontSize="12" Foreground="#52617A"/>
   </StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
    <!-- Borderless proxy settings icon in the firewall group. -->
    <Button Click="ProxyDetails_Click" ToolTip="Proxy Settings" Width="22" Height="22" Padding="2" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Focusable="True" AutomationProperties.Name="View proxy details">
     <Viewbox Width="14" Height="14" Stretch="Uniform">
      <Canvas Width="24" Height="24">
       <Path Stroke="#52617A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2 A10,10 0 1 1 11.99,2 Z M2,12 L22,12 M12,2 C5,7 5,17 12,22 M12,2 C19,7 19,17 12,22"/>
      </Canvas>
     </Viewbox>
    </Button>

      <TextBlock Text="▦" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="Windows Defender Firewall profiles"/>
      <TextBlock Text="Private" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
      <Border x:Name="PrivateLamp" Width="32" Height="16" Background="#9099A6" CornerRadius="8" Margin="0,0,10,0"><TextBlock x:Name="PrivateLampText" Text="?" FontSize="12" Foreground="White" HorizontalAlignment="Center"/></Border>
      <TextBlock Text="Public" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
      <Border x:Name="PublicLamp" Width="32" Height="16" Background="#9099A6" CornerRadius="8" Margin="0,0,10,0"><TextBlock x:Name="PublicLampText" Text="?" FontSize="12" Foreground="White" HorizontalAlignment="Center"/></Border>
      <TextBlock Text="Domain" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
      <Border x:Name="DomainLamp" Width="32" Height="16" Background="#9099A6" CornerRadius="8"><TextBlock x:Name="DomainLampText" Text="?" FontSize="12" Foreground="White" HorizontalAlignment="Center"/></Border>
     </StackPanel>
   </StackPanel>
   </Grid>
   <!-- Agent status is read from a local read-only JSON snapshot; no scan is triggered by this panel. -->
   <Border Background="#F3F6FB" CornerRadius="8" BorderBrush="#DDE3EB" BorderThickness="1" Padding="9,6" Margin="0,2,0,8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock x:Name="MonitorStateText" Text="Background monitoring: waiting for agent" FontSize="12" FontWeight="SemiBold" Foreground="#152137"/>
      <TextBlock x:Name="MonitorDetailsText" Text="Last check: —  |  Available: —  |  New: —" FontSize="12" Foreground="#52617A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="MonitorUpdatesText" Text="Updates: —" FontSize="12" Foreground="#52617A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="Last available updates"/>
      <TextBlock x:Name="AutomationStatusText" Text="Windows automation: —" FontSize="12" Foreground="#52617A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="Category automation status"/>
     </StackPanel>
     <TextBlock Grid.Column="1" x:Name="MonitorElapsedText" Text="" FontSize="12" Foreground="#F47700" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </Grid>
   </Border>
   <TextBlock x:Name="StatusText" Visibility="Collapsed" Text="Ready"/>
   <StackPanel x:Name="InstallProgressPanel" Visibility="Collapsed" Margin="0,4,0,6">
    <TextBlock x:Name="InstallProgressLabel" Text="Preparing installation…" FontSize="12" Foreground="#52617A" Margin="0,0,0,3"/>
    <ProgressBar x:Name="InstallProgressBar" Height="7" IsIndeterminate="True" Foreground="#F47700"/>
   </StackPanel>
   <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
     <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="ScanButton" Grid.Column="0" Content="⌕  Check for Updates" Style="{StaticResource PrimaryButton}" Click="Scan_Click" Width="180" HorizontalAlignment="Left" Height="30" MinHeight="30" Padding="9,3" FontSize="12"/>
      <TextBlock x:Name="ScanProgressText" Grid.Column="1" Text="" Visibility="Collapsed" Foreground="#F47700" FontSize="12" FontWeight="SemiBold" Margin="12,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </Grid>
     <Button x:Name="InstallButton" Content="↓  Install Selected Updates" Click="Install_Click" IsEnabled="False" Margin="0" Width="180" HorizontalAlignment="Left" Height="30" MinHeight="30" Padding="9,3" FontSize="12"/>
    </StackPanel>
    <Grid Grid.Column="1" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
     <Button x:Name="HistoryButton" Grid.Row="0" Grid.Column="0" Content="☷  Installation History" Click="History_Click" Margin="0,0,6,5" Height="30" MinHeight="30" Padding="9,3" FontSize="12"/>
     <Button Grid.Row="0" Grid.Column="1" Content="↓  Export CSV" Click="Export_Click" Margin="0,0,0,5" Height="30" MinHeight="30" Padding="9,3" FontSize="12"/>
     <Button x:Name="DiagnosticsButton" Grid.Row="1" Grid.Column="0" Content="⚙  Diagnostics" Click="Diagnostics_Click" Margin="0,0,6,0" Height="30" MinHeight="30" Padding="9,3" FontSize="12"/>
     <Button x:Name="HealthButton" Grid.Row="1" Grid.Column="1" Content="✓  Check Status" Click="Health_Click" Margin="0" Height="30" MinHeight="30" Padding="9,3" FontSize="12"/>
    </Grid>
   </Grid>
  </StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="☷" Foreground="#F47700" FontSize="14" FontWeight="Bold" Margin="0,-5,12,0"/><TextBlock x:Name="ListHeading" Text="Results" Foreground="#152137" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PmeControlButton" Content="N-Able PME" Click="PmeControl_Click" ToolTip="Inspect or change N-able PME service on this PC" Padding="10,5" Height="30" MinHeight="30" Margin="0,0,6,0" VerticalAlignment="Center"/><Button x:Name="ActivityLogButton" Content="Activity Log" Click="ActivityLog_Click" Style="{StaticResource CompactActionButton}" Margin="0,0,6,0"/><Button x:Name="ActivityExportButton" Content="Export Log" Click="ActivityExport_Click" Style="{StaticResource CompactActionButton}" Margin="0,0,6,0"/><StackPanel x:Name="AppsToolbar" Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="AppsScanButton" Content="Check WinGet" Click="AppsScan_Click" Style="{StaticResource CompactActionButton}" Margin="0,0,6,0"/><Button x:Name="AppsExportButton" Content="Export WinGet" Click="AppsRaw_Click" Style="{StaticResource CompactActionButton}"/></StackPanel></StackPanel></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HealthSummary" FontWeight="Medium" Text="Windows: —  |  Drivers: —  |  Applications: —" Foreground="#52617A" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"><CheckBox x:Name="IncludeOptionalUpdates" Content="Include optional" ToolTip="Also query WUA browse-only software updates. Preview updates are never selected automatically." FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" IsChecked="True"/><CheckBox x:Name="ShowAllDrivers" Content="All WUA drivers" ToolTip="Unchecked: WUA assigned driver offers only. Checked: all WUA driver offers. Firmware remains manual." Checked="DriverMode_Changed" Unchecked="DriverMode_Changed" FontSize="12" VerticalAlignment="Center" Margin="0" IsChecked="True"/></StackPanel></Grid>
    <Grid Grid.Row="2" x:Name="WindowsResultsPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="SoftwareTab" Content="Windows Updates" Click="SoftwareTab_Click" Padding="10,5" MinHeight="28"/><Button x:Name="DriversTab" Content="Drivers / Firmware" Click="DriversTab_Click" Padding="10,5" MinHeight="28"/><Button x:Name="AppsTab" Content="Applications" Click="AppsTab_Click" Padding="10,5" MinHeight="28"/><Button x:Name="HistoryTab" Content="History" Click="HistoryTab_Click" Padding="10,5" MinHeight="28"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><CheckBox x:Name="SelectAllUpdates" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" Foreground="#52617A" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="SelectAllUpdates_Click"/><TextBlock Text="Select All" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" Foreground="#52617A" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="SelectedCountText" Text="0 selected" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" Foreground="#52617A" VerticalAlignment="Center"/><Button x:Name="HistoryPdfButton" Content="Export PDF" Click="HistoryPdf_Click" Margin="8,0,0,0" Padding="7,4" Visibility="Collapsed"/></StackPanel></Grid>
    <Border x:Name="WindowsUpdatesTable" Grid.Row="1" MinHeight="90" CornerRadius="12" Background="White" BorderBrush="#CBD4E0" BorderThickness="1" ClipToBounds="True"><DataGrid Margin="1" BorderThickness="0" x:Name="UpdatesGrid" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" MouseDoubleClick="UpdateDetails_Click" ToolTip="Double-click an entry for update details" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Extended" ColumnWidth="SizeToCells"><DataGrid.Columns><DataGridTemplateColumn Header="Select" Width="52" CellStyle="{StaticResource CenteredCheckCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" IsEnabled="{Binding DataContext.CanSelectDisplayedEntry, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="UpdateCheckbox_Click"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn IsReadOnly="True" x:Name="KbColumn" Header="KB" Binding="{Binding KB}" Width="86"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn IsReadOnly="True" x:Name="CategoryColumn" Header="Version" Binding="{Binding UnifiedVersion}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn IsReadOnly="True" Header="Update" Binding="{Binding DisplayTitle}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Title}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="FontWeight" Value="Normal"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn IsReadOnly="True" Header="Status" Binding="{Binding DisplayStatus}" Width="112" HeaderStyle="{StaticResource CenteredStatusHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#344054"/><Setter Property="ToolTip" Value="{Binding StatusDetails}"/><Style.Triggers><DataTrigger Binding="{Binding DisplayStatus}" Value="Newest"><Setter Property="Foreground" Value="#008B68"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding DisplayStatus}" Value="Recommended"><Setter Property="Foreground" Value="#008B68"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding IsHistoryFailed}" Value="True"><Setter Property="Foreground" Value="#C62828"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger><DataTrigger Binding="{Binding IsHistorySuccessful}" Value="True"><Setter Property="Foreground" Value="#008B68"/></DataTrigger><DataTrigger Binding="{Binding IsHistoryPartial}" Value="True"><Setter Property="Foreground" Value="#B7791F"/></DataTrigger><DataTrigger Binding="{Binding DisplayStatus}" Value="Firmware"><Setter Property="Foreground" Value="#B7791F"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn IsReadOnly="True" Header="Date / Time" Binding="{Binding Date}" Width="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn IsReadOnly="True" x:Name="PriorityColumn" Header="Priority" Binding="{Binding Priority}" Width="95"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding PriorityExplanation}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Border><Grid Grid.Row="1" x:Name="AppsActions" Visibility="Collapsed" Margin="0,3,0,0" MinHeight="0"><Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Grid.Row="1" CornerRadius="12" Background="White" BorderBrush="#CBD4E0" BorderThickness="1" ClipToBounds="True"><DataGrid Margin="1" BorderThickness="0" x:Name="AppsGrid" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ItemsSource="{Binding AppEntries}" CanUserAddRows="False" IsReadOnly="False" MinHeight="0"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Select" Width="52" CellStyle="{StaticResource CenteredCheckCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="AppCheckbox_Click"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="KB" Binding="{Binding KB}" IsReadOnly="True" Width="86"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Version" Binding="{Binding VersionSummary}" IsReadOnly="True" Width="155"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="ToolTip" Value="{Binding VersionDetails}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Update" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="ToolTip" Value="{Binding Id}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="112"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Date / Time" Binding="{Binding Date}" IsReadOnly="True" Width="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn x:Name="AppsPriorityColumn" Header="Priority" Binding="{Binding Priority}" IsReadOnly="True" Width="78"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CenteredGridText}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding PriorityExplanation}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Border>

     </Grid></Grid>
  </Grid></Border>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,0"><Expander x:Name="MaintenanceExpander" IsExpanded="False" Background="Transparent" BorderThickness="0"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#F47700" FontSize="14" Margin="0,-3,12,0"/><TextBlock Text="Maintenance &amp; Notifications – Pilot" FontSize="14" FontWeight="SemiBold" Foreground="#152137"/></StackPanel></Expander.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="340" CanContentScroll="False" Padding="0,0,4,0"><StackPanel Margin="8,12,8,8">
    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,13"><TextBlock Text="Weekday:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="DayChoice" Width="132" SelectedIndex="3" Margin="0,0,18,0"><ComboBoxItem Content="Every day"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/><ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/><ComboBoxItem Content="Saturday"/><ComboBoxItem Content="Sunday"/></ComboBox><TextBlock Text="Time:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="TimeChoice" Text="20:00" Width="76" Height="32" Padding="8,5" Margin="0,0,20,0"/><TextBlock x:Name="ClockFormatCaption" Text="Time format:" VerticalAlignment="Center" Margin="0,0,6,0"/><RadioButton x:Name="Clock12Option" Style="{StaticResource SegmentRadio}" Content="12h" GroupName="ClockFormat" VerticalAlignment="Center" Checked="ClockFormat_Changed" Margin="0,0,5,0"/><RadioButton x:Name="Clock24Option" Style="{StaticResource SegmentRadio}" Content="24h" GroupName="ClockFormat" VerticalAlignment="Center" Checked="ClockFormat_Changed" Margin="0,0,16,0"/><TextBlock x:Name="LanguageCaption" Text="Language:" VerticalAlignment="Center" Margin="0,0,6,0"/><RadioButton x:Name="EnglishOption" Style="{StaticResource SegmentRadio}" Content="English" GroupName="Language" VerticalAlignment="Center" Checked="Language_Changed" Margin="0,0,5,0"/><RadioButton x:Name="NorwegianOption" Style="{StaticResource SegmentRadio}" Content="Norsk" GroupName="Language" VerticalAlignment="Center" Checked="Language_Changed" Margin="0,0,16,0"/><CheckBox x:Name="RemindersEnabled" Content="Enable Reminders" IsChecked="False"/></WrapPanel>
    <WrapPanel Margin="0,0,0,-8"><Button Content="▣  Save Schedule" Click="SaveSchedule_Click"/><Button Content="♧  Test Notification" Click="TestReminder_Click"/><Button Content="☷  Notification History" Click="ReminderHistory_Click"/></WrapPanel>
    <TextBlock x:Name="ScheduleStatus" Foreground="#52617A" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <Separator Margin="0,8,0,8"/>
    <TextBlock Text="Windows automation (3 categories)" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <CheckBox x:Name="WindowsAutomationEnabled" Content="Enable Windows automation" Margin="0,0,0,8" IsChecked="True"/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#DDE3EB" BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
          <TextBlock Text="1. Defender signatures" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="DefenderAutoEnabled" Content="Enabled" Margin="0,0,0,4" IsChecked="True"/>
          <TextBlock Text="Interval (minutes)" FontSize="11" Foreground="#52617A"/>
          <TextBox x:Name="DefenderIntervalMinutes" Text="60" Height="28" Margin="0,2,0,4" Padding="6,3"/>
          <TextBlock Text="Mode: Auto-install (K1)" FontSize="11" Foreground="#0F766E"/>
          <TextBlock x:Name="DefenderAutomationStatus" Text="Status: —" FontSize="11" Foreground="#52617A" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#DDE3EB" BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
          <TextBlock Text="2. Critical updates" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="CriticalAutoEnabled" Content="Enabled" Margin="0,0,0,4" IsChecked="True"/>
          <TextBlock Text="Interval (minutes)" FontSize="11" Foreground="#52617A"/>
          <TextBox x:Name="CriticalIntervalMinutes" Text="1440" Height="28" Margin="0,2,0,4" Padding="6,3"/>
          <TextBlock Text="Mode: Download + ask (soon)" FontSize="11" Foreground="#B7791F"/>
          <TextBlock Text="Preferred time" FontSize="11" Foreground="#52617A" Margin="0,4,0,0"/>
          <TextBox x:Name="CriticalPreferredTime" Text="20:00" Height="28" Margin="0,2,0,0" Padding="6,3"/>
          <TextBlock x:Name="CriticalAutomationStatus" Text="Status: not automated yet" FontSize="11" Foreground="#52617A" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#DDE3EB" BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
          <TextBlock Text="3. General Windows updates" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="GeneralAutoEnabled" Content="Enabled" Margin="0,0,0,4" IsChecked="True"/>
          <TextBlock Text="Interval (minutes)" FontSize="11" Foreground="#52617A"/>
          <TextBox x:Name="GeneralIntervalMinutes" Text="10080" Height="28" Margin="0,2,0,4" Padding="6,3"/>
          <TextBlock Text="Mode: Download + ask (soon)" FontSize="11" Foreground="#B7791F"/>
          <TextBlock Text="Preferred time" FontSize="11" Foreground="#52617A" Margin="0,4,0,0"/>
          <TextBox x:Name="GeneralPreferredTime" Text="20:00" Height="28" Margin="0,2,0,0" Padding="6,3"/>
          <TextBlock x:Name="GeneralAutomationStatus" Text="Status: not automated yet" FontSize="11" Foreground="#52617A" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Text="Never auto-reboot. Firmware remains manual. Critical/general install prompts come in a later step." FontSize="11" Foreground="#52617A" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,0,0,4">
      <CheckBox x:Name="AutoDrivers" Content="Drivers automatic (optional, not implemented)" Margin="0,0,18,6"/>
      <CheckBox x:Name="AutoApplications" Content="Application automatic (optional, not implemented)" Margin="0,0,18,6" Click="AutoApplications_Click"/>
      <TextBlock Text="Firmware: manual only" Foreground="#9B5A00" VerticalAlignment="Center" Margin="0,0,10,6"/>
      <Button Content="Save Policy" Click="SavePolicy_Click" Padding="10,4" MinHeight="29"/>
    </WrapPanel>
  </StackPanel></ScrollViewer></Expander></Border>
  <TextBlock Grid.Row="4" x:Name="FooterSafetyText" Text="Update Express: Defender signatures may auto-update when enabled. Critical/general Windows updates still require confirmation (coming next). Drivers/firmware are not installed automatically. Update Express never restarts Windows automatically." Foreground="#52617A" FontSize="12" Margin="4,10,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>