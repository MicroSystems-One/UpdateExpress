  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,0"><Expander x:Name="MaintenanceExpander" Style="{StaticResource SectionExpander}" IsExpanded="False"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#0067C0" FontSize="14" Margin="0,-3,12,0"/><TextBlock Text="Maintenance &amp; Notifications – Pilot" FontSize="15" FontWeight="Medium" Foreground="#1C1C1C"/></StackPanel></Expander.Header><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="340" CanContentScroll="False" Padding="0,0,4,0"><StackPanel Margin="8,12,8,8">
