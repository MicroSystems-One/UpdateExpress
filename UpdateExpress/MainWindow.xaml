<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UpdateExpress" x:Class="UpdateExpress.MainWindow" Title="Update Express – Windows Update Management" Icon="Assets/UpdateExpress-U.ico" Width="1024" Height="768" MinWidth="720" MinHeight="520" ResizeMode="CanResize" Background="#F3F3F3" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <local:HexToBrushConverter x:Key="HexToBrush"/>
  <!-- Win11 Settings card: flat white on gray, thin border, modest radius (no drop shadow). -->
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E5E5E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
  <!-- Win11 Settings accordion: header content left, thin stroke chevron far right (down=collapsed, up=expanded). -->
  <Style x:Key="SectionExpander" TargetType="Expander">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel LastChildFill="True">
            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Focusable="False" Padding="0"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" Padding="0,2">
                    <!-- Dock chevron first so every section shares one trailing 28px column. -->
                    <DockPanel LastChildFill="True">
                      <Grid DockPanel.Dock="Right" Width="28" Height="28" Margin="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path x:Name="ChevronDown"
                              Data="M2,4 L7,9 L12,4"
                              Stroke="#0067C0" StrokeThickness="1.35"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" Stretch="None" Width="14" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="ChevronUp"
                              Data="M2,9 L7,4 L12,9"
                              Stroke="#0067C0" StrokeThickness="1.35"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" Stretch="None" Width="14" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                      </Grid>
                      <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                        Margin="0,0,8,0"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="ChevronDown" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="ChevronUp" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Margin="0" Visibility="Collapsed"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Same as SectionExpander but without the open/close chevron (Health Check). Header click still expands. -->
  <Style x:Key="SectionExpanderNoChevron" TargetType="Expander" BasedOn="{StaticResource SectionExpander}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel LastChildFill="True">
            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Focusable="False" Padding="0"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" Padding="0,2">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Margin="0" Visibility="Collapsed"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="MinWidth" Value="0"/></Style>
  <!-- Fixed 27px row buttons (Pilot schedule actions) — same baseline, no WrapPanel drift. -->
  <Style x:Key="PilotRowButton" TargetType="Button">
    <Setter Property="Height" Value="27"/>
    <Setter Property="MinHeight" Value="27"/>
    <Setter Property="MaxHeight" Value="27"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="#1C1C1C"/>
    <Setter Property="BorderBrush" Value="#E5E5E5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IdentityValue" TargetType="TextBox">
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#1C1C1C"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="0,0,2,0"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="MinWidth" Value="24"/>
   <Setter Property="MaxWidth" Value="260"/>
   <Setter Property="Cursor" Value="IBeam"/>
  </Style>
  <Style x:Key="IdentityCopyButton" TargetType="Button">
   <Setter Property="Width" Value="22"/>
   <Setter Property="Height" Value="22"/>
   <Setter Property="MinWidth" Value="22"/>
   <Setter Property="MinHeight" Value="22"/>
   <Setter Property="Padding" Value="2"/>
   <Setter Property="Margin" Value="4,0,0,0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ToolTip" Value="Copy this value"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
       <Viewbox Width="14" Height="14" Stretch="Uniform">
        <Canvas Width="24" Height="24">
         <Path Fill="#F3F3F3" Stroke="#0067C0" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
               Data="M3,4 H12 L15.2,7.2 V16.2 H3 Z"/>
         <Path Stroke="#0067C0" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
               Data="M12,4 V7.2 H15.2"/>
         <Path Stroke="#0067C0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
               Data="M5.2,8.2 H10.2 M5.2,10.6 H10.2 M5.2,13 H10.2"/>
         <Path Fill="#F3F3F3" Stroke="#0067C0" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
               Data="M8.2,8 H16.4 L20,11.6 V21 H8.2 Z"/>
         <Path Stroke="#0067C0" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
               Data="M16.4,8 V11.6 H20"/>
         <Path Stroke="#0067C0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
               Data="M10.4,13.4 H17.2 M10.4,16 H17.2 M10.4,18.6 H17.2"/>
        </Canvas>
       </Viewbox>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#E5E5E5"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SegmentRadio" TargetType="RadioButton">
   <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="SegmentBorder" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#0067C0"/><Setter Property="Foreground" Value="White"/><Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#0067C0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Unified typography for result lists (Segoe UI Variable / Win11 Settings scale). -->
  <Style TargetType="DataGrid">
   <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#1C1C1C"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="RowBackground" Value="White"/>
   <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
   <Setter Property="AlternationCount" Value="2"/>
   <Setter Property="RowHeight" Value="34"/>
   <Setter Property="ColumnHeaderHeight" Value="34"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E5E5E5"/>
   <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#1C1C1C"/>
   <Setter Property="Background" Value="#F3F3F3"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="BorderBrush" Value="#E5E5E5"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style x:Key="CenteredStatusHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <!-- Applied explicitly to every text column: DataGridTextColumn creates its own TextBlock,
       so an implicit window TextBlock style is not reliably inherited. -->
  <Style x:Key="CenteredGridText" TargetType="TextBlock">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="CenteredCheckCell" TargetType="DataGridCell">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#1C1C1C"/>
  </Style>
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="27"/>
   <Setter Property="MinHeight" Value="27"/>
   <Setter Property="MaxHeight" Value="27"/>
   <Setter Property="Padding" Value="10,0"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="RowPrimaryButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
   <Setter Property="Background" Value="#0067C0"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#0055A8"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="InstallRowButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Opacity" Value="0.88"/></Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Outer" Property="Background" Value="#C62828"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter TargetName="Outer" Property="BorderBrush" Value="#B71C1C"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Outer" Property="Background" Value="#F0F1F4"/>
        <Setter Property="Foreground" Value="#8B95A3"/>
       </Trigger>
       <DataTrigger Binding="{Binding InstallButtonPulse, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter TargetName="Outer" Property="Background" Value="#FDECEC"/>
        <Setter Property="Foreground" Value="#C62828"/>
        <Setter TargetName="Outer" Property="BorderBrush" Value="#EF9A9A"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding InstallButtonActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter TargetName="Outer" Property="Background" Value="#C62828"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter TargetName="Outer" Property="BorderBrush" Value="#B71C1C"/>
       </DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <!-- Scroll when content overflows; Grid MinHeight fills viewport so * rows still stretch when tall enough. -->
 <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
 <Grid x:Name="MainLayout" Margin="16,0,16,12" MinHeight="{Binding ActualHeight, ElementName=MainScroll}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="ResultsRow" Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Header: left brand U; center-right two-line update status; right Check for updates. -->
  <Grid Grid.Row="0" Margin="0,8,0,12" MinHeight="88"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
    <Border Width="55" Height="55" CornerRadius="8" Background="Transparent" Margin="0,0,18,0"><Image Source="Assets/UpdateExpress-U.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
    <StackPanel VerticalAlignment="Center"><TextBlock FontSize="28" FontWeight="SemiBold"><Run Text="Update " Foreground="#1C1C1C"/><Run Text="Express" Foreground="#0067C0"/></TextBlock><TextBlock x:Name="AppSubtitle" Text="Windows Update Management · Background Monitoring" Foreground="#5D5D5D" FontSize="12" Margin="0,4,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="UpdateStatusPanel" Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal"
               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,96,0">
    <Image x:Name="UpdateStatusIconUpToDate" Source="Assets/StatusUpToDate.png" Width="48" Height="48" Stretch="Uniform"
           Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"
           VerticalAlignment="Center"/>
    <Image x:Name="UpdateStatusIconNotUpToDate" Source="Assets/StatusNotUpToDate.png" Width="48" Height="48" Stretch="Uniform"
           Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"
           VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="UpdateStatusTitle" Text="" FontSize="14" FontWeight="Normal" Foreground="#1C1C1C"
                TextAlignment="Left" HorizontalAlignment="Left"/>
     <TextBlock x:Name="UpdateStatusChecked" Text="" FontSize="12" FontWeight="Normal" Foreground="#5D5D5D" Margin="0,2,0,0"
                TextAlignment="Left" HorizontalAlignment="Left"/>
    </StackPanel>
   </StackPanel>
   <Button x:Name="ScanButton" Grid.Column="2" Content="Check for updates" Style="{StaticResource RowPrimaryButton}"
           Click="Scan_Click" VerticalAlignment="Center" HorizontalAlignment="Right"
           Height="32" MinHeight="32" MaxHeight="32" Padding="16,0" FontSize="14"
           ToolTip="Search Windows Update for available updates"
           AutomationProperties.Name="Check for updates"/>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8" VerticalAlignment="Top"><Expander x:Name="WindowsUpdateControlExpander" Style="{StaticResource SectionExpanderNoChevron}" IsExpanded="False"><Expander.Header><StackPanel><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Windows Update Status – Health Check" FontSize="15" FontWeight="Medium" Foreground="#1C1C1C" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock x:Name="OsSupportIcon" Text="?" FontSize="14" FontWeight="Bold" Foreground="#B7791F" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock x:Name="OsVersionLabel" Text="Checking Windows…" FontSize="12" FontWeight="SemiBold" Foreground="#1C1C1C" VerticalAlignment="Center"/><Button x:Name="OsSupportInfo" Content="ⓘ" Click="OsSupportInfo_Click" ToolTip="Windows lifecycle and security support" FontSize="12" Padding="3,0" Margin="3,0,0,0" Height="20" MinHeight="20" MinWidth="20" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"><Viewbox Width="22" Height="22" Margin="0,0,8,0" ToolTip="Antivirus protection status"><Canvas Width="96" Height="96"><Path x:Name="DefenderShield" Fill="#9099A6" Data="M48,5 L83,18 L83,43 C83,67 68,82 48,91 C28,82 13,67 13,43 L13,18 Z"/><Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M31,48 L43,60 L66,35"/></Canvas></Viewbox><TextBlock Text="Microsoft Defender" FontWeight="SemiBold" Foreground="#1C1C1C" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="DefenderLabel" Text="Checking…" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="DefenderChecked" Text="Not checked" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="DefenderRefreshButton" Content="Refresh" Click="DefenderRefresh_Click" FontSize="12" Padding="8,3" MinHeight="26" Height="26" Margin="0" VerticalAlignment="Center"/></StackPanel></Grid>
    <StackPanel Margin="0,8,0,0">
<!-- Aligned connectivity and firewall status: same row, same Segoe UI 11px. -->
   <Grid Margin="0,8,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <!-- Network diagnostics: independent HTTPS probes, not a Windows Update Agent test. -->
   <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0,8,0" VerticalAlignment="Center">
    <Ellipse x:Name="InternetLamp" Width="9" Height="9" Fill="#9099A6" Margin="0,0,6,0"/>
    <TextBlock x:Name="InternetStatusText" Text="Internet: checking …" FontSize="12" Foreground="#5D5D5D" Margin="0,0,18,0"/>
    <Ellipse x:Name="UpdateServerLamp" Width="9" Height="9" Fill="#9099A6" Margin="0,0,6,0"/>
    <TextBlock x:Name="UpdateServerStatusText" Text="Microsoft TCP: checking …" FontSize="12" Foreground="#5D5D5D" Margin="0,0,18,0"/>
    <Ellipse x:Name="WuaLamp" Width="9" Height="9" Fill="#9099A6" Margin="0,0,6,0"/>
    <TextBlock x:Name="WuaStatusText" Text="WUA: Not confirmed" FontSize="12" Foreground="#5D5D5D" Margin="0,0,18,0"/>
    <TextBlock x:Name="ProxyStatusText" Text="Proxy: checking …" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center"/>
    <!-- Proxy settings icon: one space after Proxy status text. -->
    <Button Click="ProxyDetails_Click" ToolTip="Proxy Settings" Width="22" Height="22" Padding="2" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Focusable="True" AutomationProperties.Name="View proxy details">
     <Viewbox Width="14" Height="14" Stretch="Uniform">
      <Canvas Width="24" Height="24">
       <Path Stroke="#0067C0" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2 A10,10 0 1 1 11.99,2 Z M2,12 L22,12 M12,2 C5,7 5,17 12,22 M12,2 C19,7 19,17 12,22"/>
      </Canvas>
     </Viewbox>
    </Button>
   </StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
      <TextBlock Text="▦" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" ToolTip="Windows Defender Firewall profiles"/>
      <TextBlock Text="Private" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
      <Border x:Name="PrivateLamp" Width="32" Height="16" Background="#9099A6" CornerRadius="8" Margin="0,0,10,0"><TextBlock x:Name="PrivateLampText" Text="?" FontSize="12" Foreground="White" HorizontalAlignment="Center"/></Border>
      <TextBlock Text="Public" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
      <Border x:Name="PublicLamp" Width="32" Height="16" Background="#9099A6" CornerRadius="8" Margin="0,0,10,0"><TextBlock x:Name="PublicLampText" Text="?" FontSize="12" Foreground="White" HorizontalAlignment="Center"/></Border>
      <TextBlock Text="Domain" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
