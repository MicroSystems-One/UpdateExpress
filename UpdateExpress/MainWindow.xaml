    </Border>
    <!-- Hidden legacy single-day reminder controls (kept for code-behind compatibility). -->
    <ComboBox x:Name="DayChoice" Width="132" SelectedIndex="3" Visibility="Collapsed"><ComboBoxItem Content="Every day"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/><ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/><ComboBoxItem Content="Saturday"/><ComboBoxItem Content="Sunday"/></ComboBox>
    <TextBox x:Name="TimeChoice" Text="20:00" Width="76" Height="32" Visibility="Collapsed"/>
    <CheckBox x:Name="WindowsAutomationEnabled" Content="Enable Windows automation" Margin="0,0,0,8" IsChecked="True"/>
    <TextBlock Text="Defender signatures update continuously when enabled. Critical and general updates download in the background and install in your maintenance window." FontSize="12" Foreground="#5D5D5D" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <Expander Style="{StaticResource SectionExpander}" Header="Advanced categories (intervals)" IsExpanded="False" Margin="0,0,0,8">
    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
          <TextBlock Text="1. Defender signatures" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="DefenderAutoEnabled" Content="Enabled" Margin="0,0,0,4" IsChecked="True"/>
          <TextBlock Text="Interval (minutes)" FontSize="12" Foreground="#5D5D5D"/>
          <TextBox x:Name="DefenderIntervalMinutes" Text="60" Height="28" Margin="0,2,0,4" Padding="6,3"/>
          <TextBlock Text="Mode: Auto-install (K1)" FontSize="12" Foreground="#0F766E"/>
          <TextBlock x:Name="DefenderAutomationStatus" Text="Status: —" FontSize="12" Foreground="#5D5D5D" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
          <TextBlock Text="2. Critical updates" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="CriticalAutoEnabled" Content="Enabled" Margin="0,0,0,4" IsChecked="True"/>
          <TextBlock Text="Interval (minutes)" FontSize="12" Foreground="#5D5D5D"/>
          <TextBox x:Name="CriticalIntervalMinutes" Text="1440" Height="28" Margin="0,2,0,4" Padding="6,3"/>
          <TextBlock Text="Mode: Download + ask (critical updates)" FontSize="12" Foreground="#0F766E"/>
          <TextBlock Text="Preferred time" FontSize="12" Foreground="#5D5D5D" Margin="0,4,0,0"/>
          <TextBox x:Name="CriticalPreferredTime" Text="12:00" Height="28" Margin="0,2,0,0" Padding="6,3"/>
          <TextBlock x:Name="CriticalAutomationStatus" Text="Status: waiting for agent" FontSize="12" Foreground="#5D5D5D" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
          <TextBlock Text="3. General Windows updates" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <CheckBox x:Name="GeneralAutoEnabled" Content="Enabled" Margin="0,0,0,4" IsChecked="True"/>
          <TextBlock Text="Interval (minutes)" FontSize="12" Foreground="#5D5D5D"/>
          <TextBox x:Name="GeneralIntervalMinutes" Text="10080" Height="28" Margin="0,2,0,4" Padding="6,3"/>
          <TextBlock Text="Mode: Download + ask (general Windows update)" FontSize="12" Foreground="#0F766E"/>
          <TextBlock Text="Preferred time" FontSize="12" Foreground="#5D5D5D" Margin="0,4,0,0"/>
          <TextBox x:Name="GeneralPreferredTime" Text="12:00" Height="28" Margin="0,2,0,0" Padding="6,3"/>
          <TextBlock x:Name="GeneralAutomationStatus" Text="Status: waiting for agent" FontSize="12" Foreground="#5D5D5D" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
    </Expander>
    <Border Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Optional auto-reboot (critical updates / general Windows update only)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="AutoRebootEnabled" Content="Allow optional auto-reboot after Critical/General installs (default off)" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <RadioButton x:Name="AutoRebootConfirmOption" Content="Ask for confirmation" GroupName="AutoRebootMode" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
          <RadioButton x:Name="AutoRebootOutsideOption" Content="Only outside active hours" GroupName="AutoRebootMode" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel Margin="0,2,0,0">
          <TextBlock Text="Active hours" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="ActiveHoursStart" Text="7" Width="40" Height="26" Padding="4,2" Margin="0,0,4,0"/>
          <TextBlock Text="–" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox x:Name="ActiveHoursEnd" Text="18" Width="40" Height="26" Padding="4,2" Margin="0,0,14,0"/>
          <TextBlock Text="Countdown (sec)" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="RebootCountdownSeconds" Text="300" Width="56" Height="26" Padding="4,2"/>
        </WrapPanel>
        <TextBlock Text="When enabled and a restart is required: confirm now, or defer until outside active hours (tray asks again). Firmware remains manual." FontSize="12" Foreground="#5D5D5D" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Border Background="#F4FBF7" BorderBrush="#C9E8D6" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Update until current" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Searches, downloads, and installs Windows software updates, restarts when Windows requires it, then repeats until none remain. Drivers, firmware, and feature updates stay manual." FontSize="12" Foreground="#5D5D5D" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="UpdateUntilCurrentButton" Content="Start update cycle" Click="UpdateUntilCurrent_Click" Padding="10,4" MinHeight="29" Margin="0,0,10,0"/>
          <TextBlock x:Name="UpdateUntilCurrentStatus" Text="Not running" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Text="Critical and general updates download in the background and ask before install. Default preferred time is 12:00. Auto-reboot is optional and off by default. Drivers and applications follow the same ask-before-install path when enabled below." FontSize="12" Foreground="#5D5D5D" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <Border Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Automatic check intervals" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="How often the background agent looks for updates. Applications default to 4 hours; drivers to 24 hours; Windows pending-update monitor to 6 hours. Firmware stays manual." FontSize="12" Foreground="#5D5D5D" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,2">
          <TextBlock Text="Applications (hours)" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,6,6"/>
          <TextBox x:Name="ApplicationsCheckHours" Text="4" Width="48" Height="26" Padding="4,2" Margin="0,0,16,6" ToolTip="Minimum 1 hour. Default 4."/>
          <TextBlock Text="Drivers (hours)" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,6,6"/>
          <TextBox x:Name="DriversCheckHours" Text="24" Width="48" Height="26" Padding="4,2" Margin="0,0,16,6" ToolTip="Minimum 24 hours. Default 24. Firmware is not scanned automatically."/>
          <TextBlock Text="Windows monitor (hours)" FontSize="12" Foreground="#5D5D5D" VerticalAlignment="Center" Margin="0,0,6,6"/>
          <TextBox x:Name="WindowsMonitorHours" Text="6" Width="48" Height="26" Padding="4,2" Margin="0,0,0,6" ToolTip="How often the tray agent checks for pending Windows updates. Minimum 1 hour. Default 6."/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <WrapPanel Margin="0,0,0,4">
      <CheckBox x:Name="AutoDrivers" Content="Drivers automatic" Margin="0,0,18,6" ToolTip="Assigned WUA drivers: background download, ask before install. Firmware stays manual."/>
      <CheckBox x:Name="AutoApplications" Content="Application automatic" Margin="0,0,18,6" Click="AutoApplications_Click" ToolTip="WinGet upgrades: ask before install at the preferred time used by Critical updates."/>
      <TextBlock Text="Firmware: manual only" Foreground="#9B5A00" VerticalAlignment="Center" Margin="0,0,10,6"/>
      <Button Content="Save Policy" Click="SavePolicy_Click" Padding="10,4" MinHeight="29"/>
    </WrapPanel>
  </StackPanel></ScrollViewer></Expander></Border>
  <StackPanel Grid.Row="5" Margin="4,10,4,0">
  <TextBlock x:Name="FooterSafetyText" Text="Update Express: Defender signatures may auto-update when enabled. Critical and general Windows updates download automatically and require confirmation before install. Optional auto-reboot after critical updates / general Windows update is off by default (confirm or outside active hours). Drivers and WinGet applications use the same ask-before-install path when enabled; firmware stays manual." Foreground="#5D5D5D" FontSize="12" TextWrapping="Wrap"/>
  <TextBlock x:Name="BrandSiteLink" Text="www.microsystems.one" FontSize="14" FontWeight="SemiBold"
             Foreground="#0067C0" Cursor="Hand" HorizontalAlignment="Center" Margin="0,14,0,4"
             TextDecorations="Underline" ToolTip="https://www.microsystems.one"
             MouseLeftButtonUp="BrandSiteLink_Click"/>
 </StackPanel>
 </Grid>
 </ScrollViewer>
</Window>
