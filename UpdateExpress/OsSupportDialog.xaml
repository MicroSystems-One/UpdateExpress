<Window x:Class="UpdateExpress.OsSupportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Security Support"
        Width="520" SizeToContent="Height" MinWidth="440" MaxWidth="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F6FB" FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="DialogActionButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MaxHeight" Value="30"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#182335"/>
      <Setter Property="BorderBrush" Value="#CED5DF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="#EBF2FA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="16" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="14" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="InfoIcon" Width="32" Height="32" Margin="0,2,14,0" VerticalAlignment="Top"
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Foreground="#152137" FontSize="13"
                     LineHeight="20"/>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#334155" FontSize="13">
            <Run x:Name="ReferenceLabel" Text="Reference:"/>
            <LineBreak/>
            <Hyperlink x:Name="ReferenceLink" RequestNavigate="ReferenceLink_RequestNavigate"
                       ToolTip="Open in default browser">
              <Run x:Name="ReferenceLinkText"/>
            </Hyperlink>
          </TextBlock>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Height="30" Margin="0,18,0,0">
        <Button x:Name="CopyButton" Content="Copy link" Style="{StaticResource DialogActionButton}"
                Click="Copy_Click" ToolTip="Copy the reference URL to the clipboard"/>
        <Button x:Name="OkButton" Content="OK" Style="{StaticResource DialogActionButton}" Margin="0"
                IsDefault="True" Click="Ok_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
